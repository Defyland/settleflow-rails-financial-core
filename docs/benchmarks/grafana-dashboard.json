{
  "title": "SettleFlow API Overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "targets": [
        {
          "expr": "sum(rate(settleflow_http_requests_total[5m])) by (path, status)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(settleflow_http_request_duration_seconds_bucket[5m])) by (le, path))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p99 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(settleflow_http_request_duration_seconds_bucket[5m])) by (le, path))"
        }
      ]
    }
  ]
}
