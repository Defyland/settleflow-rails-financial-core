{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Defyland/settleflow-rails-financial-core/docs/events/split_posted.v1.json",
  "title": "split_posted v1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "organization_id", "wallet_id", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "split_posted" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "const": "settleflow" },
    "organization_id": { "type": "string" },
    "wallet_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["split_payment_id", "source_wallet_id", "journal_entry_id", "total_amount_cents", "currency", "entries", "status"],
      "properties": {
        "split_payment_id": { "type": "string" },
        "source_wallet_id": { "type": "string" },
        "journal_entry_id": { "type": "string" },
        "total_amount_cents": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["destination_wallet_id", "amount_cents"],
            "properties": {
              "destination_wallet_id": { "type": "string" },
              "amount_cents": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          }
        },
        "status": { "type": "string", "const": "posted" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
