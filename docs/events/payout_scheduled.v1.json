{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Defyland/settleflow-rails-financial-core/docs/events/payout_scheduled.v1.json",
  "title": "payout_scheduled v1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "organization_id", "wallet_id", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "payout_scheduled" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "const": "settleflow" },
    "organization_id": { "type": "string" },
    "wallet_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["payout_id", "schedule_journal_entry_id", "external_id", "amount_cents", "currency", "settlement_due_on", "status"],
      "properties": {
        "payout_id": { "type": "string" },
        "schedule_journal_entry_id": { "type": "string" },
        "external_id": { "type": "string" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string" },
        "settlement_due_on": { "type": "string", "format": "date" },
        "destination_kind": { "type": "string" },
        "status": { "type": "string", "const": "scheduled" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
