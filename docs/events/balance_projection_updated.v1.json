{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Defyland/settleflow-rails-financial-core/docs/events/balance_projection_updated.v1.json",
  "title": "balance_projection_updated v1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "organization_id", "wallet_id", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "balance_projection_updated" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "const": "settleflow" },
    "organization_id": { "type": "string" },
    "wallet_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["balance_projection_id", "source_journal_entry_id", "currency", "available_cents", "pending_cents", "blocked_cents"],
      "properties": {
        "balance_projection_id": { "type": "string" },
        "source_journal_entry_id": { "type": "string" },
        "currency": { "type": "string" },
        "available_cents": { "type": "integer" },
        "pending_cents": { "type": "integer" },
        "blocked_cents": { "type": "integer" },
        "previous_available_cents": { "type": ["integer", "null"] },
        "previous_pending_cents": { "type": ["integer", "null"] },
        "previous_blocked_cents": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
