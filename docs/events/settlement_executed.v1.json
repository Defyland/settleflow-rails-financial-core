{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Defyland/settleflow-rails-financial-core/docs/events/settlement_executed.v1.json",
  "title": "settlement_executed v1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "organization_id", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "settlement_executed" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "const": "settleflow" },
    "organization_id": { "type": "string" },
    "wallet_id": { "type": ["string", "null"] },
    "correlation_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["settlement_id", "journal_entry_id", "settlement_reference", "amount_cents", "currency", "status", "settled_at"],
      "properties": {
        "settlement_id": { "type": "string" },
        "journal_entry_id": { "type": "string" },
        "settlement_reference": { "type": "string" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string" },
        "status": { "type": "string", "const": "settled" },
        "settled_at": { "type": "string", "format": "date-time" },
        "provider": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
