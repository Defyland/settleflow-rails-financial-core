<header class="page-header">
  <div>
    <h1>Audit logs</h1>
    <p>API and operator actions with request and correlation IDs.</p>
  </div>
  <%= form_with url: ops_audit_logs_path, method: :get, class: "filters" do |form| %>
    <%= form.search_field :q, value: @query, placeholder: "Search audit" %>
    <%= form.submit "Search", class: "button button--secondary" %>
  <% end %>
</header>

<section class="panel">
  <table class="table">
    <thead>
      <tr>
        <th>Time</th>
        <th>Actor</th>
        <th>Action</th>
        <th>Subject</th>
        <th>Status</th>
        <th>Correlation</th>
      </tr>
    </thead>
    <tbody>
      <% @audit_logs.each do |log| %>
        <tr>
          <td><%= log.created_at.to_fs(:short) %></td>
          <td><%= log.actor_type %>#<%= log.actor_id || "api" %></td>
          <td><%= log.action %></td>
          <td><%= log.subject_type %>#<%= log.subject_id %></td>
          <td><%= log.metadata["status"] || "n/a" %></td>
          <td><%= log.correlation_id.to_s.first(12) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "ops/shared/pagination" %>
</section>
